<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>opendoor</id>
    <version>5.18.0</version>
    <title>OpenDoor</title>
    <authors>stanislav-web</authors>
    <owners>stanislav-web</owners>
    <licenseUrl>https://github.com/stanislav-web/OpenDoor/blob/v5.18.0/LICENSE</licenseUrl>
    <projectUrl>https://github.com/stanislav-web/OpenDoor</projectUrl>
    <projectSourceUrl>https://github.com/stanislav-web/OpenDoor</projectSourceUrl>
    <docsUrl>https://opendoor.readthedocs.io/</docsUrl>
    <bugTrackerUrl>https://github.com/stanislav-web/OpenDoor/issues</bugTrackerUrl>
    <packageSourceUrl>https://github.com/stanislav-web/OpenDoor/tree/v5.18.0/chocolatey</packageSourceUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/stanislav-web/OpenDoor@v5.18.0/docs/icons/opendoor-icon-256.png</iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>CLI scanner for authorized web reconnaissance, directory discovery, and exposure assessment.</summary>
    <description>
OpenDoor is an open-source CLI recon platform for authorized web reconnaissance, directory discovery, subdomain enumeration, fingerprint detection, WAF detection, controlled header-bypass probing, response filtering, reporting, verified open-redirect checks, and transport-based scanning workflows.

Use OpenDoor only on systems you own or have explicit permission to test.
    </description>
    <releaseNotes>https://github.com/stanislav-web/OpenDoor/releases/tag/v5.18.0</releaseNotes>
    <tags>opendoor security recon directory-scanner subdomain-scanner web-recon pentesting owasp cli python</tags>
    <dependencies>
      <dependency id="python313" version="[3.13.0,3.14.0)" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>